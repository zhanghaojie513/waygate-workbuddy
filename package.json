    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
